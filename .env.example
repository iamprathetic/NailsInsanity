# Copy this file to `.env` and fill in the values. Never commit real secrets.

# Database — Neon Postgres connection string (used locally and in production).
DATABASE_URL=""

# Admin panel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Telegram order alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cloudinary (product image storage). Either set CLOUDINARY_URL, or the three
# individual values below — not both are required.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
